# SUPABASE
SUPABASE_URL=https://TU-PROYECTO.supabase.co
SUPABASE_KEY=TU_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=TU_SERVICE_ROLE_KEY
SUPABASE_TEMP_BUCKET=custodia-pendiente

# TELEGRAM
TELEGRAM_TOKEN=TU_TELEGRAM_TOKEN
AUTHORIZED_CHAT_IDS=ID_ADMIN_1,ID_ADMIN_2
TELEGRAM_WEBHOOK_SECRET=TU_SECRETO_ALEATORIO

# GOOGLE DRIVE
GOOGLE_CLIENT_ID=TU_GOOGLE_CLIENT_ID
GOOGLE_CLIENT_SECRET=TU_GOOGLE_CLIENT_SECRET
GOOGLE_REFRESH_TOKEN=TU_GOOGLE_REFRESH_TOKEN
GOOGLE_FOLDER_ID=ID_ACTUAL_DRIVE_PROYECTO
GOOGLE_DRIVE_ROOT_ID=root

# APP
PUBLIC_BASE_URL=https://TU-PROYECTO.up.railway.app
MAX_BATCH_FILES=100
MAX_FILE_SIZE_MB=25
DRIVE_CACHE_TTL_SECONDS=60
HTTP_TIMEOUT_SECONDS=20

# RESILIENCIA
GOOGLE_API_RETRIES=2
EXTERNAL_RETRY_ATTEMPTS=3
EXTERNAL_RETRY_BACKOFF_SECONDS=0.75

# OUTBOX TELEGRAM
OUTBOX_WORKER_ENABLED=true
OUTBOX_POLL_SECONDS=15
OUTBOX_BATCH_SIZE=20
OUTBOX_MAX_ATTEMPTS=8
